# Local Supabase (values printed by `pnpm db:status` from the repo root)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Password of the seed people (supabase/seed.sql). Server-only: it signs the user
# switcher in on the server and never reaches the browser. Leave it empty to
# disable the switcher.
DEMO_USER_PASSWORD=password123
